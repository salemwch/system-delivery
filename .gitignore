# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

