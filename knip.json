{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "src/worker.ts",
        "src/scripts/*.ts",
        "src/modules/*/index.ts",
        "src/shared/*/index.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": [
        "pino-pretty",
        "@testcontainers/postgresql",
        "drizzle-kit",
        "@types/ws"
      ]
    },
    "apps/driver": {
      "entry": ["e2e/**/*.test.ts", ".detoxrc.js", "e2e/jest.config.js"]
    }
  },
  "ignoreBinaries": ["k6"],
  "ignore": ["load/**"]
}
