# Driver app, local development. Copy to .env.local (git-ignored); Expo loads it
# when Metro starts, so a change needs only a Metro restart, not a rebuild.
#
# EXPO_PUBLIC_* values are compiled into the app and readable by anyone who
# has it: an address, never a secret.
#
# Where the API is, as seen FROM THE PHONE:
#   USB (recommended):  http://localhost:3000   after `adb reverse tcp:3000 tcp:3000`
#   Same Wi-Fi:         http://<your PC's IP>:3000   (Windows firewall must allow 3000)
#   Emulator:           http://10.0.2.2:3000   (the default when unset)
#   Outdoors:           https://<tunnel>.trycloudflare.com   (cloudflared tunnel; https required for release builds)
#
# Field-test and production builds do not read this file: they take the value
# from the EAS environment (eas.json profiles).
EXPO_PUBLIC_API_URL=http://localhost:3000
