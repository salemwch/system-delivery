# Copy to .env and adjust. NEVER commit .env — it is gitignored.
# Production secrets live in a secrets manager, never in a file.
# See docs/07-security-architecture.md §6.3.

# ─── Deployment mode ────────────────────────────────────────────────────────
# saas      → multi-tenant, self-serve signup, platform admin surfaces enabled
# dedicated → single-tenant instance owned by one courier; signup/billing off
DEPLOYMENT_MODE=saas
NODE_ENV=development
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=delivery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# The application connects as dp_app (NO BYPASSRLS). Migrations use dp_migrator.
# The outbox relay connects as dp_relay — SELECT+UPDATE on `outbox` only, with a
# permissive RLS policy on that one table so it can read every tenant's events.
# Three different connection strings on purpose (least privilege per identity).
APP_DB_PASSWORD=app_dev_password
MIGRATOR_DB_PASSWORD=migrator_dev_password
RELAY_DB_PASSWORD=relay_dev_password
DATABASE_URL=postgresql://dp_app:app_dev_password@localhost:5432/delivery
MIGRATION_DATABASE_URL=postgresql://dp_migrator:migrator_dev_password@localhost:5432/delivery
RELAY_DATABASE_URL=postgresql://dp_relay:relay_dev_password@localhost:5432/delivery

# ─── Valkey ─────────────────────────────────────────────────────────────────
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
VALKEY_COMMAND_TIMEOUT_MS=5000

# ─── Outbox relay (core-worker) ─────────────────────────────────────────────
# The relay drains the transactional outbox into a Valkey Stream. Tuning knobs
# have safe defaults; override only with a measured reason.
OUTBOX_STREAM_KEY=outbox.events
OUTBOX_STREAM_MAXLEN=100000
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_RELAY_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_BASE_BACKOFF_MS=1000
OUTBOX_RELAY_MAX_BACKOFF_MS=60000
OUTBOX_RELAY_ALERT_AGE_SECONDS=60

# ─── Object storage (MinIO locally, Spaces/S3 in production) ────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=delivery-pod
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── Routing ────────────────────────────────────────────────────────────────
OSRM_PORT=5000
OSRM_URL=http://localhost:5000

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate real values: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_only_change_me_access
JWT_REFRESH_SECRET=dev_only_change_me_refresh
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_DAYS=30
DRIVER_ACCESS_TTL_SECONDS=3600
DRIVER_REFRESH_TTL_DAYS=90
TRACKING_TOKEN_SECRET=dev_only_change_me_tracking
TRACKING_TOKEN_TTL_DAYS=30

# ─── Notifications ──────────────────────────────────────────────────────────
# Provider selection is deliberately late-bound. The NotificationProvider
# abstraction means switching gateways is a config change, not a code change.
# Tunisian sender-ID registration takes ~18 days — start it early.
# NOTE: A2P SMS in Tunisia is ONE-WAY. Recipients cannot reply, so reschedule
#       flows must use a tracking-page link, never "reply to this message".
# NOTE: Arabic uses UCS-2 (70 chars/segment vs 160) — budget templates per language.
NOTIFICATION_SMS_PROVIDER=console
SMS_SENDER_ID=
SMS_API_KEY=
SMS_API_SECRET=
SMS_BASE_URL=

# Firebase Cloud Messaging for driver push
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Geocoding / maps ───────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=core-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# ─── API ────────────────────────────────────────────────────────────────────
PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
